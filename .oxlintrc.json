{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "func-style": ["error", "declaration"],
    "unicorn/filename-case": "error",
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true,
        "ignoreCase": true
      }
    ]
  },
  "ignorePatterns": [".claude/**", "src/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "sort-imports": "off"
      }
    }
  ]
}
