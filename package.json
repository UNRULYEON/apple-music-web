{
  "name": "apple-music-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern .",
    "format": "oxfmt --check --no-error-on-unmatched-pattern .",
    "format:fix": "oxfmt --no-error-on-unmatched-pattern .",
    "ci:local": "bun scripts/ci-local/index.ts",
    "generate-music-kit-token": "bun scripts/generate-music-kit-token/index.ts",
    "generate-routes": "tsr generate",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.12.0",
    "ora": "^9.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "picocolors": "^1.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.70.0"
